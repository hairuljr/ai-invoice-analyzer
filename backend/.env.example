# Copy to backend/.env and fill in. Never commit .env.

# OpenAI-compatible endpoint (e.g. your AI proxy). Leave empty to use api.openai.com.
LLM_BASE_URL=
LLM_API_KEY=
# Must be a multimodal model that accepts PDF and images
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60

DATABASE_URL=sqlite:///./invoices.db
MAX_UPLOAD_MB=10
